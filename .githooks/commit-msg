#!/bin/sh
# Enforce Conventional Commits 1.0.0 on the subject line.
# Enable once per clone: git config core.hooksPath .githooks
subject=$(sed -n '/^[^#]/{p;q;}' "$1")
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac
types='feat|fix|refactor|test|docs|style|build|chore|perf'
scopes='viewer|collect|remote|publish|serve|validate|skill|tests|repo'
if printf '%s\n' "$subject" | grep -Eq "^($types)(\(($scopes)\))?!?: [^ ].{0,99}$"; then
  exit 0
fi
cat >&2 <<MSG
commit-msg: subject is not a Conventional Commit:
  $subject
Expected: <type>(<scope>)?!?: <subject>, at most ~100 chars
  types:  ${types}
  scopes: ${scopes}
Example: refactor(viewer): split viewer.js into ES modules
See CONTRIBUTING.md.
MSG
exit 1
