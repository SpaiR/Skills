+/* diff-review viewer: главы гайда, диффы, аннотации к строкам, отправка фидбека. Без зависимостей. */
+(() => {
+  'use strict';
+
+  const TOKEN = new URLSearchParams(location.search).get('t') || '';
+  const BIG_FILE_LINES = 400;
