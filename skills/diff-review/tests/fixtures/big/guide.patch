+:root {
+  --bg: #f6f7f9; --panel: #ffffff; --panel-2: #f0f2f5; --border: #d9dde3; --text: #1d2228; --muted: #67707c;
+  --accent: #3b5bdb; --accent-soft: #e7ecff;
+  --add-bg: #e6f6ea; --add-num: #ccebd4; --add-text: #1a7f37;
+  --del-bg: #fdecec; --del-num: #f7d4d4; --del-text: #c62828;
+  --hunk-bg: #eef2fb; --sel: #fff3bf; --sel-num: #ffe066;
+  --warn-bg: #fff4e5; --warn-border: #f0a43a; --imp-bg: #eef1ff; --imp-border: #5c7cfa; --note-bg: #f1f3f5; --note-border: #adb5bd;
+  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  color-scheme: light dark;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #15181d; --panel: #1c2027; --panel-2: #232831; --border: #323844; --text: #e3e6ea; --muted: #8d96a3;
+    --accent: #7c95ff; --accent-soft: #252d4a;
+    --add-bg: #13291b; --add-num: #1a3a25; --add-text: #56d27a;
+    --del-bg: #331a1c; --del-num: #4a2226; --del-text: #ff7b7b;
+    --hunk-bg: #1e2638; --sel: #3d3415; --sel-num: #5c4b12;
+    --warn-bg: #33270f; --warn-border: #d08a1e; --imp-bg: #1f2547; --imp-border: #6b83ff; --note-bg: #232831; --note-border: #5a6270;
+  }
+}
+
+* { box-sizing: border-box; }
+html { scroll-padding-top: 96px; }
+body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.55 var(--sans); }
+code, pre, .mono { font-family: var(--mono); font-size: 13px; }
+p code, li code, .file-summary code, .md code { background: var(--panel-2); border: 1px solid var(--border); border-radius: 4px; padding: 0 4px; }
+.muted { color: var(--muted); }
+.small { font-size: 12.5px; }
+.add { color: var(--add-text); }
+.del { color: var(--del-text); }
+.loading { padding: 40px; color: var(--muted); }
+
+/* шапка */
+#top { position: sticky; top: 0; z-index: 20; background: var(--panel); border-bottom: 1px solid var(--border); }
+.top-row { display: flex; gap: 16px; align-items: center; justify-content: space-between; padding: 10px 20px; flex-wrap: wrap; }
+.top-title h1 { margin: 0; font-size: 18px; line-height: 1.3; }
+.top-meta { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; font-size: 13px; margin-top: 2px; }
+.pill { font-family: var(--mono); font-size: 12px; background: var(--accent-soft); color: var(--accent); padding: 1px 8px; border-radius: 999px; }
+.top-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.progress { position: relative; width: 110px; height: 26px; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 12.5px; }
+.progress-bar { position: absolute; left: 0; top: 0; bottom: 0; background: var(--add-num); }
+.progress span { position: relative; }
+.seg { display: inline-flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
+.seg button { border: 0; background: transparent; color: var(--text); padding: 4px 10px; cursor: pointer; font: inherit; font-size: 13px; }
+.seg button.on { background: var(--accent-soft); color: var(--accent); }
+.save-error { background: var(--del-bg); color: var(--del-text); padding: 6px 20px; font-size: 13px; }
+
+.btn { border: 1px solid var(--border); background: var(--panel); color: var(--text); border-radius: 6px; padding: 5px 12px; font: inherit; font-size: 13.5px; cursor: pointer; }
+.btn:hover { background: var(--panel-2); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
+.btn.primary:hover { filter: brightness(1.08); }
+.btn:disabled { opacity: .5; cursor: default; }
+.btn.small { padding: 3px 10px; font-size: 13px; }
+.link { border: 0; background: none; color: var(--accent); cursor: pointer; padding: 0; font: inherit; font-size: 13px; }
+.link.danger { color: var(--del-text); }
+
+/* раскладка */
+#layout { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 24px; padding: 20px; max-width: 1700px; margin: 0 auto; }
+@media (max-width: 1000px) { #layout { grid-template-columns: 1fr; } #toc { position: static !important; max-height: none !important; } }
+
+/* оглавление */
+#toc { position: sticky; top: 84px; align-self: start; max-height: calc(100vh - 104px); overflow: auto; font-size: 13.5px; }
+.toc-head { text-transform: uppercase; letter-spacing: .06em; font-size: 11.5px; color: var(--muted); margin-bottom: 8px; }
+.toc-sec { padding: 6px 0 8px; border-bottom: 1px solid var(--border); }
+.toc-row { display: flex; gap: 6px; align-items: flex-start; }
+.toc-row input { margin-top: 4px; }
+.toc-row a { color: var(--text); text-decoration: none; }
+.toc-row a:hover { color: var(--accent); }
+.toc-sec.reviewed .toc-row a { color: var(--muted); text-decoration: line-through; }
+.toc-num { font-family: var(--mono); color: var(--muted); font-size: 12px; }
+.chips { display: flex; flex-wrap: wrap; gap: 4px; margin: 6px 0 0 22px; }
+.chip { border: 1px solid var(--border); background: var(--panel); color: var(--text); border-radius: 4px; padding: 0 6px; font: 12px var(--mono); cursor: pointer; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.chip:hover { border-color: var(--accent); }
+.chip-stat { color: var(--muted); }
+
+/* основная колонка */
+#main { min-width: 0; }
+.intent { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 14px 20px; margin-bottom: 18px; font-size: 16px; }
+.intent .md p { margin: 0 0 6px; }
+.commits summary { cursor: pointer; color: var(--muted); font-size: 13px; }
+.commits ul { margin: 6px 0 0; padding-left: 18px; font-size: 13px; }
+
+.sec { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; margin-bottom: 18px; overflow: hidden; }
+.sec.flash, .file.flash { outline: 2px solid var(--accent); outline-offset: 2px; }
+.sec-head { display: flex; gap: 12px; align-items: center; padding: 12px 18px; cursor: pointer; user-select: none; }
+.sec-head:hover { background: var(--panel-2); }
+.sec-head h2 { margin: 0; font-size: 17px; flex: 1; }
+.sec.reviewed .sec-head h2 { color: var(--muted); }
+.sec-num { font-family: var(--mono); font-size: 12px; color: var(--muted); min-width: 56px; }
+.reviewed-toggle { display: inline-flex; gap: 6px; align-items: center; font-size: 13px; color: var(--muted); cursor: pointer; }
+.caret { display: inline-block; transition: transform .12s; color: var(--muted); }
+.caret.open { transform: rotate(90deg); }
+.overview { padding: 0 22px 4px; border-top: 1px solid var(--border); padding-top: 12px; }
+.md p { margin: 0 0 10px; }
+.md ul, .md ol { margin: 0 0 10px; padding-left: 22px; }
+.md h4 { margin: 12px 0 6px; font-size: 15px; }
+.md blockquote { margin: 0 0 10px; padding-left: 12px; border-left: 3px solid var(--border); color: var(--muted); }
+.md-code { background: var(--panel-2); border: 1px solid var(--border); border-radius: 6px; padding: 8px 12px; overflow: auto; margin: 0 0 10px; }
+.md-code code { background: none; border: 0; padding: 0; }
+.callout { border-left: 4px solid var(--note-border); background: var(--note-bg); border-radius: 6px; padding: 8px 12px; margin: 0 0 10px; }
+.callout p:last-child { margin-bottom: 0; }
+.callout-title { font-weight: 600; font-size: 13px; margin-bottom: 2px; }
+.callout-important, .callout-tip, .callout-note { border-color: var(--imp-border); background: var(--imp-bg); }
+.callout-warning, .callout-caution { border-color: var(--warn-border); background: var(--warn-bg); }
+.sec-comment { padding: 0 22px 12px; }
+
+/* файлы */
+.file { margin: 0 14px 14px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
+.file-head { display: flex; gap: 10px; align-items: center; padding: 7px 12px; background: var(--panel-2); cursor: pointer; font-family: var(--mono); font-size: 13px; user-select: none; }
+.file-head .path { flex: 1; min-width: 0; overflow-wrap: anywhere; }
+.status { font-weight: 700; font-size: 11px; width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; border-radius: 4px; background: var(--border); }
+.st-added { background: var(--add-num); color: var(--add-text); }
+.st-deleted { background: var(--del-num); color: var(--del-text); }
+.st-renamed, .st-copied { background: var(--accent-soft); color: var(--accent); }
+.badge { background: var(--sel-num); border-radius: 999px; padding: 0 8px; font-size: 11.5px; font-family: var(--sans); }
+.stat { white-space: nowrap; }
+.file-summary { padding: 7px 14px; font-size: 14px; border-top: 1px solid var(--border); }
+.file-empty { padding: 10px 14px; color: var(--muted); font-size: 13px; border-top: 1px solid var(--border); }
+
+.diff-wrap { overflow-x: auto; border-top: 1px solid var(--border); }
+table.diff { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 12.5px; line-height: 1.5; }
+table.diff.split { table-layout: fixed; }
+table.diff.split col.c-num { width: 56px; }
+table.diff td { padding: 0 8px; vertical-align: top; }
+td.num { width: 1%; min-width: 44px; text-align: right; color: var(--muted); user-select: none; cursor: pointer; white-space: nowrap; }
+td.num:hover { color: var(--accent); text-decoration: underline; }
+td.num.empty { cursor: default; text-decoration: none; }
+td.code { white-space: pre-wrap; word-break: break-word; }
+.sign { user-select: none; color: var(--muted); display: inline-block; width: 1.2ch; }
+tr.add td.code, td.code.add { background: var(--add-bg); }
+tr.add td.num { background: var(--add-num); }
+tr.del td.code, td.code.del { background: var(--del-bg); }
+tr.del td.num { background: var(--del-num); }
+td.code.filler { background: var(--panel-2); }
+tr.hunk td { background: var(--hunk-bg); color: var(--muted); padding: 3px 10px; }
+tr.ln.sel td.code { background: var(--sel) !important; }
+td.num.sel { background: var(--sel-num) !important; color: var(--text); }
+.nonl { color: var(--del-text); }
+
+/* аннотации */
+tr.annot-row td { padding: 6px 10px; background: var(--panel); font-family: var(--sans); font-size: 14px; }
+.note { border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 6px; padding: 6px 10px; background: var(--panel); }
+.note-head { display: flex; gap: 12px; align-items: center; justify-content: space-between; font-size: 12.5px; color: var(--muted); }
+.note-actions { display: inline-flex; gap: 12px; }
+.note-text { white-space: pre-wrap; margin-top: 2px; }
+pre.suggestion { background: var(--add-bg); border-radius: 4px; padding: 6px 8px; margin: 4px 0 0; white-space: pre-wrap; }
+.editor { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--accent); border-radius: 6px; padding: 8px 10px; background: var(--panel); }
+.editor textarea { width: 100%; resize: vertical; border: 1px solid var(--border); border-radius: 4px; padding: 6px 8px; background: var(--bg); color: var(--text); font: 14px/1.45 var(--sans); }
+.editor textarea.mono { font: 12.5px/1.45 var(--mono); }
+.editor-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.editor .link { align-self: flex-start; }
+
+/* модалка */
+.modal-back { position: fixed; inset: 0; background: rgba(0, 0, 0, .45); z-index: 50; display: flex; align-items: center; justify-content: center; padding: 20px; }
+.modal { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 18px 22px; width: min(760px, 100%); max-height: 90vh; overflow: auto; display: flex; flex-direction: column; gap: 10px; }
+.modal h3 { margin: 0; }
+.modal p { margin: 0; }
+.modal textarea { width: 100%; resize: vertical; border: 1px solid var(--border); border-radius: 6px; padding: 8px; background: var(--bg); color: var(--text); font: 14px/1.45 var(--sans); }
+.modal summary { cursor: pointer; color: var(--muted); font-size: 13px; }
+.preview { background: var(--panel-2); border: 1px solid var(--border); border-radius: 6px; padding: 10px; max-height: 40vh; overflow: auto; white-space: pre-wrap; margin: 6px 0 0; }
+.finished { max-width: 640px; margin: 18vh auto; text-align: center; }
